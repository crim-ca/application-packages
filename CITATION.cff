cff-version: 1.2.0
title: "crim-ca/application-packages"
message: |
  CWL Application Packages (OGC API - Processes / Weaver compatible) for GIS and climate tools:
  GDAL, PDAL, WhiteboxTools, rasterio, CDO, NCO, xclim, supermorecado, s2mosaic.
  If you use these packages, please cite them as below.

authors:
  - name: &crim Computer Research Institute of Montréal
    city: "Montréal"
    region: "Québec"
    alias: CRIM
    website: "https://www.crim.ca/"
    email: "info@crim.ca"
    tel: "1 (514) 840-1234"
    country: CA
    post-code: "H3N 1M3"
    address: "101 – 405, avenue Ogilvy"
  - &fmigneault
    given-names: "Francis"
    family-names: "Charette-Migneault"
    alias: fmigneault
    email: "francis.charette-migneault@crim.ca"
    orcid: "https://orcid.org/0000-0003-4862-3349"
    affiliation: *crim

contact:
  - *fmigneault

identifiers:
